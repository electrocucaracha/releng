 337 │ 337 │ def parse_email(data: bytes | str) -> tuple[RawMetadata, dict[str, list[str]]]:               
 338 │ 338 │     """Parse a distribution's metadata stored as email headers (e.g. from ``METADATA``).      
 339 │ 339 │                                                                                               
 340 │ 340 │     This function returns a two-item tuple of dicts. The first dict is of                     
 341 │ 341 │     recognized fields from the core metadata specification. Fields that can be                
 342 │ 342 │     parsed and translated into Python's built-in types are converted                          
 343 │ 343 │     appropriately. All other fields are left as-is. Fields that are allowed to                
 344 │ 344 │     appear multiple times are stored as lists.                                                
 345 │ 345 │                                                                                               
 346 │ 346 │     The second dict contains all other fields from the metadata. This includes                
 347 │ 347 │     any unrecognized fields. It also includes any fields which are expected to                
 348 │ 348 │     be parsed into a built-in type but were not formatted appropriately. Finally,             
 349 │ 349 │     any fields that are expected to appear only once but are repeated are                     
 350 │ 350 │     included in this dict.                                                                    
 351 │ 351 │                                                                                               
 352 │ 352 │     """                                                                                       
 353 │ 353 │     raw: dict[str, str | list[str] | dict[str, str]] = {}                                     
 354 │ 354 │     unparsed: dict[str, list[str]] = {}                                                       
 355 │ 355 │                                                                                               
 356 │ 356 │     if isinstance(data, str):                                                                 
 357 │ 357 │         parsed = email.parser.Parser(policy=email.policy.compat32).parsestr(data)             
 358 │ 358 │     else:                                                                                     
 359 │ 359 │         parsed = email.parser.BytesParser(policy=email.policy.compat32).parsebytes(data)      
 360 │ 360 │                                                                                               
 361 │ 361 │     # We have to wrap parsed.keys() in a set, because in the case of multiple                 
 362 │ 362 │     # values for a key (a list), the key will appear multiple times in the                    
 363 │ 363 │     # list of keys, but we're avoiding that by using get_all().                               
 364 │ 364 │     for name_with_case in frozenset(parsed.keys()):                                           
 365 │ 365 │         # Header names in RFC are case insensitive, so we'll normalize to all                 
 366 │ 366 │         # lower case to make comparisons easier.                                              
 367 │ 367 │         name = name_with_case.lower()                                                         
 368 │ 368 │                                                                                               
 369 │ 369 │         # We use get_all() here, even for fields that aren't multiple use,                    
 370 │ 370 │         # because otherwise someone could have e.g. two Name fields, and we                   
 371 │ 371 │         # would just silently ignore it rather than doing something about it.                 
 372 │ 372 │         headers = parsed.get_all(name) or []                                                  
 373 │ 373 │                                                                                               
 374 │ 374 │         # The way the email module works when parsing bytes is that it                        
 375 │ 375 │         # unconditionally decodes the bytes as ascii using the surrogateescape                
 376 │ 376 │         # handler. When you pull that data back out (such as with get_all() ),                
 377 │ 377 │         # it looks to see if the str has any surrogate escapes, and if it does                
 378 │ 378 │         # it wraps it in a Header object instead of returning the string.                     
 379 │ 379 │         #                                                                                     
 380 │ 380 │         # As such, we'll look for those Header objects, and fix up the encoding.              
 381 │ 381 │         value = []                                                                            
 382 │ 382 │         # Flag if we have run into any issues processing the headers, thus                    
 383 │ 383 │         # signalling that the data belongs in 'unparsed'.                                     
 384 │ 384 │         valid_encoding = True                                                                 
 385 │ 385 │         for h in headers:                                                                     
 386 │ 386 │             # It's unclear if this can return more types than just a Header or                
 387 │ 387 │             # a str, so we'll just assert here to make sure.                                  
 388 │ 388 │             assert isinstance(h, (email.header.Header, str))                                  
 389 │ 389 │                                                                                               
 390 │ 390 │             # If it's a header object, we need to do our little dance to get                  
 391 │ 391 │             # the real data out of it. In cases where there is invalid data                   
 392 │ 392 │             # we're going to end up with mojibake, but there's no obvious, good               
 393 │ 393 │             # way around that without reimplementing parts of the Header object               
 394 │ 394 │             # ourselves.                                                                      
 395 │ 395 │             #                                                                                 
 396 │ 396 │             # That should be fine since, if mojibacked happens, this key is                   
 397 │ 397 │             # going into the unparsed dict anyways.                                           
 398 │ 398 │             if isinstance(h, email.header.Header):                                            
 399 │ 399 │                 # The Header object stores it's data as chunks, and each chunk                
 400 │ 400 │                 # can be independently encoded, so we'll need to check each                   
 401 │ 401 │                 # of them.                                                                    
 402 │ 402 │                 chunks: list[tuple[bytes, str | None]] = []                                   
 403 │ 403 │                 for binary, _encoding in email.header.decode_header(h):                       
 404 │ 404 │                     try:                                                                      
 405 │ 405 │                         binary.decode("utf8", "strict")                                       
 406 │ 406 │                     except UnicodeDecodeError:                                                
 407 │ 407 │                         # Enable mojibake.                                                    
 408 │ 408 │                         encoding = "latin1"                                                   
 409 │ 409 │                         valid_encoding = False                                                
 410 │ 410 │                     else:                                                                     
 411 │ 411 │                         encoding = "utf8"                                                     
 412 │ 412 │                     chunks.append((binary, encoding))                                         
 413 │ 413 │                                                                                               
 414 │ 414 │                 # Turn our chunks back into a Header object, then let that                    
 415 │ 415 │                 # Header object do the right thing to turn them into a                        
 416 │ 416 │                 # string for us.                                                              
 417 │ 417 │                 value.append(str(email.header.make_header(chunks)))                           
 418 │ 418 │             # This is already a string, so just add it.                                       
 419 │ 419 │             else:                                                                             
 420 │ 420 │                 value.append(h)                                                               
 421 │ 421 │                                                                                               
 422 │ 422 │         # We've processed all of our values to get them into a list of str,                   
 423 │ 423 │         # but we may have mojibake data, in which case this is an unparsed                    
 424 │ 424 │         # field.                                                                              
 425 │ 425 │         if not valid_encoding:                                                                
 426 │ 426 │             unparsed[name] = value                                                            
 427 │ 427 │             continue                                                                          
 428 │ 428 │                                                                                               
 429 │ 429 │         raw_name = _EMAIL_TO_RAW_MAPPING.get(name)                                            
 430 │ 430 │         if raw_name is None:                                                                  
 431 │ 431 │             # This is a bit of a weird situation, we've encountered a key that                
 432 │ 432 │             # we don't know what it means, so we don't know whether it's meant                
 433 │ 433 │             # to be a list or not.                                                            
 434 │ 434 │             #                                                                                 
 435 │ 435 │             # Since we can't really tell one way or another, we'll just leave it              
 436 │ 436 │             # as a list, even though it may be a single item list, because that's             
 437 │ 437 │             # what makes the most sense for email headers.                                    
 438 │ 438 │             unparsed[name] = value                                                            
 439 │ 439 │             continue                                                                          
 440 │ 440 │                                                                                               
 441 │ 441 │         # If this is one of our string fields, then we'll check to see if our                 
 442 │ 442 │         # value is a list of a single item. If it is then we'll assume that                   
 443 │ 443 │         # it was emitted as a single string, and unwrap the str from inside                   
 444 │ 444 │         # the list.                                                                           
 445 │ 445 │         #                                                                                     
 446 │ 446 │         # If it's any other kind of data, then we haven't the faintest clue                   
 447 │ 447 │         # what we should parse it as, and we have to just add it to our list                  
 448 │ 448 │         # of unparsed stuff.                                                                  
 449 │ 449 │         if raw_name in _STRING_FIELDS and len(value) == 1:                                    
 450 │ 450 │             raw[raw_name] = value[0]                                                          
 451 │ 451 │         # If this is import_names, we need to special case the empty field                    
 452 │ 452 │         # case, which converts to an empty list instead of None. We can't let                 
 453 │ 453 │         # the empty case slip through, as it will fail validation.                            
 454 │ 454 │         elif raw_name == "import_names" and value == [""]:                                    
 455 │ 455 │             raw[raw_name] = []                                                                
 456 │ 456 │         # If this is one of our list of string fields, then we can just assign                
 457 │ 457 │         # the value, since email *only* has strings, and our get_all() call                   
 458 │ 458 │         # above ensures that this is a list.                                                  
 459 │ 459 │         elif raw_name in _LIST_FIELDS:                                                        
 460 │ 460 │             raw[raw_name] = value                                                             
 461 │ 461 │         # Special Case: Keywords                                                              
 462 │ 462 │         # The keywords field is implemented in the metadata spec as a str,                    
 463 │ 463 │         # but it conceptually is a list of strings, and is serialized using                   
 464 │ 464 │         # ", ".join(keywords), so we'll do some light data massaging to turn                  
 465 │ 465 │         # this into what it logically is.                                                     
 466 │ 466 │         elif raw_name == "keywords" and len(value) == 1:                                      
 467 │ 467 │             raw[raw_name] = _parse_keywords(value[0])                                         
 468 │ 468 │         # Special Case: Project-URL                                                           
 469 │ 469 │         # The project urls is implemented in the metadata spec as a list of                   
 470 │ 470 │         # specially-formatted strings that represent a key and a value, which                 
 471 │ 471 │         # is fundamentally a mapping, however the email format doesn't support                
 472 │ 472 │         # mappings in a sane way, so it was crammed into a list of strings                    
 473 │ 473 │         # instead.                                                                            
 474 │ 474 │         #                                                                                     
 475 │ 475 │         # We will do a little light data massaging to turn this into a map as                 
 476 │ 476 │         # it logically should be.                                                             
 477 │ 477 │         elif raw_name == "project_urls":                                                      
 478 │ 478 │             try:                                                                              
 479 │ 479 │                 raw[raw_name] = _parse_project_urls(value)                                    
 480 │ 480 │             except KeyError:                                                                  
 481 │ 481 │                 unparsed[name] = value                                                        
 482 │ 482 │         # Nothing that we've done has managed to parse this, so it'll just                    
 483 │ 483 │         # throw it in our unparsable data and move on.                                        
 484 │ 484 │         else:                                                                                 
 485 │ 485 │             unparsed[name] = value                                                            
 486 │ 486 │                                                                                               
 487 │ 487 │     # We need to support getting the Description from the message payload in                  
 488 │ 488 │     # addition to getting it from the the headers. This does mean, though, there              
 489 │ 489 │     # is the possibility of it being set both ways, in which case we put both                 
 490 │ 490 │     # in 'unparsed' since we don't know which is right.                                       
 491 │ 491 │     try:                                                                                      
 492 │ 492 │         payload = _get_payload(parsed, data)                                                  
 493 │ 493 │     except ValueError:                                                                        
 494 │ 494 │         unparsed.setdefault("description", []).append(                                        
 495 │ 495 │             parsed.get_payload(decode=isinstance(data, bytes))  # type: ignore[call-overload] 
 496 │ 496 │         )                                                                                     
 497 │ 497 │     else:                                                                                     
 498 │ 498 │         if payload:                                                                           
 499 │ 499 │             # Check to see if we've already got a description, if so then both                
 500 │ 500 │             # it, and this body move to unparsable.                                           
 501 │ 501 │             if "description" in raw:                                                          
 502 │ 502 │                 description_header = cast("str", raw.pop("description"))                      
 503 │ 503 │                 unparsed.setdefault("description", []).extend(                                
 504 │ 504 │                     [description_header, payload]                                             
 505 │ 505 │                 )                                                                             
 506 │ 506 │             elif "description" in unparsed:                                                   
 507 │ 507 │                 unparsed["description"].append(payload)                                       
 508 │ 508 │             else:                                                                             
 509 │ 509 │                 raw["description"] = payload                                                  
 510 │ 510 │                                                                                               
 511 │ 511 │     # We need to cast our `raw` to a metadata, because a TypedDict only support               
 512 │ 512 │     # literal key names, but we're computing our key names on purpose, but the                
 513 │ 513 │     # way this function is implemented, our `TypedDict` can only have valid key               
 514 │ 514 │     # names.                                                                                  
 515 │ 515 │     return cast("RawMetadata", raw), unparsed                                                 
